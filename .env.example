# Copiază fișierul în .env.local și completează valorile din Google Cloud Console.
# Toate trei sunt publice prin natura lor (ajung în browser); protecția vine din
# originile autorizate ale clientului OAuth și din restricția de referrer a cheii API.

# APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# APIs & Services > Credentials > API key (restricționată la Google Picker API + domeniile tale)
VITE_GOOGLE_API_KEY=

# Numărul proiectului (Project number, doar cifre) din Cloud Console > Dashboard.
# Picker-ul are nevoie de el ca să dea aplicației acces la Sheet-ul ales (scope drive.file).
VITE_GOOGLE_APP_ID=
